<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Overlay: display-over-other-apps (SYSTEM_ALERT_WINDOW). Separate Settings grant. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service for authorized MediaProjection sessions. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Notifications (Android 13+); OS capture indicator remains mandatory. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- S4 AudioPlaybackCapture of permitted USAGE_MEDIA/GAME streams. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- No AccessibilityService in default MVP (PRD locked decision). -->

    <application
        android:name=".ObserverApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIObserver">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AIObserver"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Placeholder: MediaProjection foreground session. Wire in capture spike. -->
        <service
            android:name=".feature.capture.ObservationCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Placeholder: floating overlay window controller. -->
        <service
            android:name=".feature.overlay.OverlayService"
            android:exported="false" />
    </application>
</manifest>
