{
  "manifest_version": 3,
  "name": "OBZRAi",
  "version": "0.2.0",
  "description": "Observe the active tab. Local Research Hub. No account required.",
  "permissions": ["activeTab", "storage", "sidePanel", "scripting", "alarms"],
  "host_permissions": [],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OBZRAi",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "commands": {
    "save-active-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save active tab observation"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
